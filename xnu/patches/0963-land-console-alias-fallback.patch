land: report the console alias guards and fall back to any free slot

The retained console is only worth having where the failures still are,
and on the phone it stops at "no kernel slot": every guard in
sweet_early_map_final() returns silently, and the framebuffer window it
depends on is described by arm_vm_physmap_init, which runs after it.  Name
each guard, then take any free block entry of the same L2 table once the
final tables are live, highest slot first.  The tap is armed with the
address and expected value of that entry so the console goes quiet instead
of writing into memory the kernel has since claimed.
---
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 3a12201..184e02d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1853,6 +1853,8 @@ static uint64_t sweet_early_ram_aux;
 
 /* pexpert/arm/land_sdhci.c owns the page layout */
 extern void land_ram_console_arm(uint64_t va, const char *tag, uint64_t aux);
+extern void land_vm_alias_report(const char *why, uint64_t a, uint64_t b);
+extern void land_ram_console_slot(uint64_t slot_va, uint64_t expect);
 
 static void
 sweet_early_map_final(void)
@@ -1860,15 +1862,18 @@ sweet_early_map_final(void)
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		land_vm_alias_report("no l1", l1, 0);
 		return;
 	}
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	unsigned int first = (unsigned int)((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
 	if (first + 6 > TTE_PGENTRIES) {
+		land_vm_alias_report("no range", first, TTE_PGENTRIES);
 		return;
 	}
 	for (unsigned int i = 0; i < 6; i++) {
 		if (l2[first + i] != ARM_TTE_EMPTY) {
+			land_vm_alias_report("busy slot", first + i, l2[first + i]);
 			return;
 		}
 	}
@@ -1906,6 +1911,53 @@ sweet_early_map_final(void)
 	__asm__ volatile("dsb ishst" ::: "memory");
 	sweet_early_fb_mapped = true;
 }
+
+/*
+ * land (Redmi 3S): the fallback.  Called once the final tables are live, so
+ * the KVA is completely described and "empty" here means empty for good as
+ * far as arm_vm_init is concerned.  Anything else in this window that the
+ * kernel wants later it fills in, which is why the tap is handed the address
+ * of the entry it is using: the console must stop writing the moment the slot
+ * is no longer ours.  Highest slot first, because the static kernel mappings
+ * grow up from VM_MIN_KERNEL_ADDRESS and the top of the window is what is
+ * left over.
+ */
+static void
+land_console_map_kernel(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	unsigned int first, i;
+
+	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		land_vm_alias_report("late no l1", l1, 0);
+		return;
+	}
+	{
+		tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+		tt_entry_t entry = SWEET_EARLY_RAM_BLOCK_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+
+		first = (unsigned int)((va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+		for (i = TTE_PGENTRIES; i-- > 0;) {
+			if (l2[i] != ARM_TTE_EMPTY) {
+				continue;
+			}
+			l2[i] = entry;
+			__asm__ volatile("dsb ishst; tlbi vmalle1; dsb ish; isb" ::: "memory");
+			sweet_early_ram_va = (va - ((vm_map_address_t)first * ARM_TT_L2_SIZE)) +
+			    ((vm_map_address_t)i * ARM_TT_L2_SIZE) + SWEET_EARLY_RAM_PAGE_OFF;
+			sweet_early_ram_aux = i;
+			sweet_early_ram_mapped = true;
+			land_ram_console_slot((uint64_t)&l2[i], (uint64_t)entry);
+			land_vm_alias_report("late slot", i, (uint64_t)entry);
+			return;
+		}
+		land_vm_alias_report("late none", first, TTE_PGENTRIES);
+	}
+}
 #endif
 
 #if defined(SWEET) && !defined(TOPAZ_4K)
@@ -2289,6 +2341,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	/* TTBR0 goes away next: the console page moves onto the kernel alias, or off
 	 * memory entirely if the table had no slot left for it.
 	 */
+	if (!sweet_early_ram_mapped) {
+		land_console_map_kernel();
+	}
 	land_ram_console_arm(sweet_early_ram_mapped ? sweet_early_ram_va : 0,
 	    sweet_early_ram_mapped ? "the kernel alias" : "no kernel slot, console off",
 	    sweet_early_ram_aux);

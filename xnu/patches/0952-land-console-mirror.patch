land: mirror every console character into dip

uart_putc_options_() is where kprintf, IOLog and BSD printf all arrive on this port, so a
tap there captures the console including panic output.  The mirror writes a 4 KiB ring into
blocks 64..71 of dip and stays off until the probe arms it.
---
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 19f27cd..c239e5b 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -27,6 +27,11 @@
 #include <pexpert/arm64/board_config.h>
 #include <arm64/proc_reg.h>
 #include <arm64/sweet_early.h>
+
+/* land: pexpert/arm/land_sdhci.c mirrors console output into dip (blocks 64..71);
+ * the mirror stays off until the probe arms it, because io_map needs threads */
+extern void land_console_tap(char c);
+
 #include <pexpert/arm/protos.h>
 #include <kern/sched_prim.h>
 #if HIBERNATION
@@ -1153,6 +1158,8 @@ uart_putc_options_(char c, bool poll, bool force)
 {
 	struct pe_serial_functions *fns = gPESF;
 
+	land_console_tap(c);
+
 	while (fns != NULL) {
 		if (force || serial_do_transmit) {
 			while (!fns->transmit_ready()) {

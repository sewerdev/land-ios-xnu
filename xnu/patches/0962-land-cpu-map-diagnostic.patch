land: print the cpu map when the MPIDR lookup fails

ml_get_cpu_number() returning -1 is what ends the phone boot, and the
assert that follows names no number.  Report the searched id, the raw
MPIDR, how many cpus the tree described and each phys_id, once, through
the DRAM console mirror in pexpert/arm/land_sdhci.c - kprintf is silent
this early, which is why the first version of this printed nothing.
---
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 4fdefca..10c45a4 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1204,6 +1204,16 @@ ml_get_boot_cluster_type(void)
 	return topology_info.boot_cluster->cluster_type;
 }
 
+/*
+ * Set once by the diagnostic in ml_get_cpu_number(): the failing lookup is on
+ * a path that runs repeatedly, and the map does not change.
+ */
+static int land_cpumap_reported;
+
+/* pexpert/arm/land_sdhci.c: writes the map into the retained console page */
+extern void land_cpumap_report(uint32_t want, uint64_t mpidr, int num_cpus,
+    int max_cpu_id, const uint32_t *ids, int n);
+
 int
 ml_get_cpu_number(uint32_t phys_id)
 {
@@ -1215,6 +1225,29 @@ ml_get_cpu_number(uint32_t phys_id)
 		}
 	}
 
+	/*
+	 * land (Redmi 3S): the callers assert on the -1, which says only that a
+	 * number is wrong, and two sides can be wrong here - the MPIDR the
+	 * bootloader left us on, or the cpu tree the kernel was handed.  Report
+	 * the map once, through the DRAM console mirror rather than kprintf: at
+	 * this point the serial layer can still be switched off, and a message
+	 * that never reaches a console is no message at all.
+	 */
+	if (land_cpumap_reported == 0) {
+		uint64_t mpidr = 0;
+		unsigned i;
+		uint32_t ids[8];
+		int n = 0;
+
+		land_cpumap_reported = 1;
+		MRS(mpidr, "MPIDR_EL1");
+		for (i = 0; i < topology_info.num_cpus && i < 8; i++) {
+			ids[n++] = topology_info.cpus[i].phys_id;
+		}
+		land_cpumap_report(phys_id, mpidr, (int)topology_info.num_cpus,
+		    topology_info.max_cpu_id, ids, n);
+	}
+
 	return -1;
 }
 

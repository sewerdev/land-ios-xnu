diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index a2a8c1b..7526bea 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1939,8 +1939,15 @@ sleh_irq(arm_saved_state_t *state)
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
 	 */
+#if defined(LAND_GICV2)
+	extern unsigned long pe_gicc_base;	/* vm_offset_t, pexpert/arm/pe_fiq.c */
+	/* GICv2: reading GICC_IAR acknowledges, the EOI write deactivates. */
+	uint64_t iar = (*(volatile uint32_t *)(pe_gicc_base + GICC_IAR)) & 0x3FF;
+	uint32_t intid = (uint32_t)iar;
+#else
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
+#endif
 
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
@@ -1951,11 +1958,19 @@ sleh_irq(arm_saved_state_t *state)
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
 		rtclock_intr(TRUE);
 		INTERRUPT_MASKED_DEBUG_END();
+		#if defined(LAND_GICV2)
+		*(volatile uint32_t *)(pe_gicc_base + GICC_EOIR) = (uint32_t)iar;
+		#else
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		#endif
 	} else if (intid < 16) {
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
 		/* Ack before handling so an IPI raised meanwhile is not lost */
+		#if defined(LAND_GICV2)
+		*(volatile uint32_t *)(pe_gicc_base + GICC_EOIR) = (uint32_t)iar;
+		#else
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		#endif
 		__builtin_arm_isb(ISB_SY);
 		cpu_signal_handler();
 	} else {
@@ -1966,7 +1981,11 @@ sleh_irq(arm_saved_state_t *state)
 			    cdp->interrupt_nub,
 			    intid);
 		}
+		#if defined(LAND_GICV2)
+		*(volatile uint32_t *)(pe_gicc_base + GICC_EOIR) = (uint32_t)iar;
+		#else
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		#endif
 	}
 	__builtin_arm_isb(ISB_SY);
 #else
